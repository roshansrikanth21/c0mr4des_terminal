# Copy to backend/.env and fill in. NEVER commit backend/.env.

# Angel One SmartAPI - optional, gives real-time candles + live option prices/OI.
# Without these the app uses Yahoo Finance (delayed a few minutes, no option chain).
ANGEL_API_KEY=
ANGEL_CLIENT_ID=
ANGEL_PASSWORD=        # your 4-digit MPIN
ANGEL_TOTP_KEY=        # the base32 secret shown when you enabled TOTP

# X / Twitter search - optional and paid (X has no free search API).
X_BEARER_TOKEN=

# Real orders. Default off. When true AND Angel One is connected, the Trade plan panel shows a
# "Place real order" button: one LIMIT order per click, after a confirm dialog, with the
# trades/day, daily-loss and capital caps re-checked on the server. Exits stay manual.
LIVE_TRADING=false

# Phone alerts (free). Telegram: message @BotFather -> /newbot -> copy the token. Then send your bot any
# message and open https://api.telegram.org/bot<TOKEN>/getUpdates to find "chat":{"id": ...}.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# Optional alternative: ntfy.sh app, subscribe to a long random topic name.
NTFY_TOPIC=
