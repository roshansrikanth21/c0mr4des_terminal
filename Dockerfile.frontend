# Build stage
FROM node:18-alpine AS build
WORKDIR /app
COPY package*.json ./
RUN npm install
COPY . .
RUN npm run build

# Production server stage
FROM nginx:alpine
COPY --from=build /app/dist /usr/share/nginx/html
# Provide custom nginx config if needed for SPA routing
EXPOSE 80
CMD ["nginx", "-g", "daemon off;"]
